# Export these in your shell before running the real agentic method.
# SARA_BASE_URL includes /v1; the client appends /chat/completions.
SARA_BASE_URL=http://127.0.0.1:8080/v1
SARA_MODEL=qwen3.5:9b
SARA_API_KEY=
SARA_TIMEOUT_SECONDS=600
# Optional: pin the downloaded model and server settings in recorded runs.
# SARA_RUNTIME_MANIFEST=outputs/sara_runtime.json

# Docker note: the compose service runs with network_mode: host precisely so
# that this 127.0.0.1 value works unchanged inside the container. The
# llama.cpp server binds to 127.0.0.1 and is not reachable from a bridge
# network. See docs/DOCKER.md.
